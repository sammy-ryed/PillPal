# Copy this file to .env and fill in your values.
# Never commit real secrets to version control.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# OCR engines (set to false to disable)
USE_EASYOCR=true
USE_TESSERACT=true
USE_DONUT_FALLBACK=true
DONUT_FALLBACK_TRIGGER_CONFIDENCE=0.50
DONUT_MODEL_ID=chinmays18/medical-prescription-ocr
DONUT_MAX_LENGTH=512
DONUT_ASSUMED_CONFIDENCE=0.50
HF_TOKEN=your-huggingface-token-optional

# Confidence thresholds
OCR_CONFIDENCE_THRESHOLD=0.45
MEDICINE_MATCH_THRESHOLD=72
LOW_CONFIDENCE_WARNING_THRESHOLD=0.60

# Upload
MAX_UPLOAD_SIZE_MB=10

# Dev
DEBUG=false
